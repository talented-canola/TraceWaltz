+"""Execute the generated script itself, including non-ASCII output and timeout."""
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from evotrace.compiler import VERIFIER_SCRIPT
+
+
+class GeneratedVerifierTests(unittest.TestCase):
+    def execute(self, body, timeout=5):
+        with tempfile.TemporaryDirectory(prefix="evotrace-verifier-contract-") as folder:
+            root = Path(folder)
+            script = root / "verifier.py"
+            script.write_text(VERIFIER_SCRIPT, encoding="utf-8")
+            command = f'"{sys.executable}" -c "{body}"'
+            (root / "verifier.json").write_text(json.dumps({"commands": [command], "require_change": False, "timeout_seconds": timeout}), encoding="utf-8")
+            subprocess.run(["git", "init", "-q", str(root)], check=True, capture_output=True)
+            environment = dict(os.environ, PYTHONUTF8="0", PYTHONIOENCODING="utf-8")
+            result = subprocess.run([sys.executable, str(script), "--repo", str(root), "--json"], env=environment, text=True, encoding="utf-8", capture_output=True, timeout=10)
+            self.assertTrue(result.stdout, result.stderr)
+            return result, json.loads(result.stdout)
+
+    def test_unicode_command_output_keeps_a_valid_report(self):
+        result, report = self.execute("print(chr(0x4e2d) + chr(0x6587))")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertTrue(report["passed"])
+        self.assertIn("中文", report["checks"][0]["output"])
+
+    def test_timeout_with_partial_output_keeps_a_failure_report(self):
+        result, report = self.execute("import time; print('before_timeout', flush=True); time.sleep(2)", timeout=0.2)
+        self.assertEqual(result.returncode, 1, result.stderr)
+        self.assertFalse(report["passed"])
+        self.assertEqual(report["checks"][0]["exit_code"], 124)
+        self.assertIn("before_timeout", report["checks"][0]["output"])
