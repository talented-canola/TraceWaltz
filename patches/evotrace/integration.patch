new file mode 100644
index 0000000..0105534
--- /dev/null
+++ b/src/evotrace/provenance.py
@@ -0,0 +1,105 @@
+"""Version the inputs used to construct a task, independently of observation times."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Dict
+
+from .errors import EvoTraceError
+from .util import load_jsonl, read_json
+
+PROVENANCE_SCHEMA = "evotrace-source-v1"
+
+
+def digest_json(value: Any) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")).hexdigest()
+
+
+def file_digest(path: Path):
+    if not path.is_file():
+        return None
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def source_revision(session_dir: Path, trajectory: Dict[str, Any]) -> str:
+    source = trajectory.get("source") or {}
+    if source.get("kind") == "synthetic_hardening":
+        bundle = session_dir.parent.parent / "benchmarks" / session_dir.name
+        if (bundle / "task.json").is_file():
+            return derived_source_revision(bundle, read_json(bundle / "task.json"))
+    repository = trajectory.get("repository") or {}
+    events = session_dir / "events.jsonl"
+    return digest_json({
+        "schema": PROVENANCE_SCHEMA,
+        "source": {key: source.get(key) for key in ("kind", "agent", "source_session_id", "parent_id")},
+        "session_id": trajectory.get("session_id"),
+        "task": (trajectory.get("task") or {}).get("text"),
+        "repository": {key: repository.get(key) for key in ("base_commit", "reconstruction_confidence")},
+        "events": [{"kind": item.get("kind"), "data": item.get("data")} for item in load_jsonl(events)] if events.exists() else [],
+        "verification": trajectory.get("verification") or {},
+        "files": {name: file_digest(session_dir / name) for name in (
+            "patches/initial.patch", "patches/final.patch", "environment/untracked-initial.tar.gz", "environment/untracked-final.tar.gz")},
+    })
+
+
+def stamp_source(session_dir: Path, trajectory: Dict[str, Any]) -> Dict[str, Any]:
+    trajectory["provenance_schema"] = PROVENANCE_SCHEMA
+    trajectory["source_revision"] = source_revision(session_dir, trajectory)
+    return trajectory
+
+
+def derived_source_revision(bundle: Path, manifest: Dict[str, Any]) -> str:
+    return digest_json({"schema": "evotrace-derived-v1", "parent": manifest.get("source"),
+                        "task": manifest.get("task"),
+                        "base": file_digest(bundle / "environment" / "base.tar.gz"),
+                        "reference": file_digest(bundle / "patches" / "reference.patch"),
+                        "hidden_tests": file_digest(bundle / "patches" / "hidden-tests.patch")})
+
+
+def bundle_source_status(store, bundle: Path, manifest=None, _seen=None) -> Dict[str, Any]:
+    seen = set() if _seen is None else set(_seen)
+    identity = str(bundle.resolve())
+    if identity in seen:
+        return {"matches": False, "code": "INVALID_PROVENANCE", "current_revision": None, "bundle_revision": None}
+    seen.add(identity)
+    manifest = manifest or read_json(bundle / "task.json")
+    expected = manifest.get("source_revision")
+    if not expected:
+        return {"matches": False, "code": "LEGACY_PROVENANCE", "current_revision": None, "bundle_revision": None}
+    source = manifest.get("source") or {}
+    if source.get("kind") == "synthetic_hardening":
+        parent = store.benchmarks / str(source.get("parent_id") or "")
+        # Import lazily: catalog consumes this module too.
+        from .catalog import bundle_sha256
+        valid = bool(source.get("parent_bundle_sha256") and parent != bundle and (parent / "task.json").is_file())
+        valid = valid and source["parent_bundle_sha256"] == bundle_sha256(parent)
+        valid = valid and bundle_source_status(store, parent, _seen=seen)["matches"]
+        current = derived_source_revision(bundle, manifest)
+        valid = valid and current == expected and all(file_digest(bundle / name) for name in (
+            "environment/base.tar.gz", "patches/reference.patch", "patches/hidden-tests.patch"))
+        return {"matches": bool(valid), "code": None if valid else "STALE_PARENT_OR_CHILD", "current_revision": current, "bundle_revision": expected}
+    sid = str(source.get("session_id") or manifest.get("id") or bundle.name)
+    session = store.sessions / sid
+    if not (session / "trajectory.json").exists():
+        # Portable bundles can be checked on their own; no local candidate is claimed current.
+        return {"matches": True, "code": None, "current_revision": None, "bundle_revision": expected, "detached": True}
+    current = source_revision(session, read_json(session / "trajectory.json"))
+    if manifest.get("compiler_digest") and manifest["compiler_digest"] != file_digest(Path(__file__).with_name("compiler.py")):
+        return {"matches": False, "code": "STALE_BUILD_SPEC", "current_revision": current, "bundle_revision": expected}
+    return {"matches": current == expected, "code": None if current == expected else "STALE_SOURCE", "current_revision": current, "bundle_revision": expected}
+
+
+def require_current_bundle(store, bundle: Path, *, expected_digest=None) -> Dict[str, Any]:
+    status = bundle_source_status(store, bundle)
+    if not status["matches"]:
+        raise EvoTraceError(f"{status['code']}: task bundle does not match its current source; rebuild explicitly")
+    if expected_digest:
+        from .catalog import bundle_sha256
+        if bundle_sha256(bundle) != expected_digest:
+            raise EvoTraceError("STALE_BUNDLE: the bundle changed after this review produced it")
+    return status
