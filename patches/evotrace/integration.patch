diff --git a/src/evotrace/integration.py b/src/evotrace/integration.py
new file mode 100644
index 0000000..0053e13
--- /dev/null
+++ b/src/evotrace/integration.py
@@ -0,0 +1,223 @@
+"""Product-owned integration boundary for task review and existing asset operations.
+
+Callers launch the original review command. This module collects its actual reports;
+it does not schedule the four roles or replace their prompts.
+"""
+from __future__ import annotations
+
+import json
+from dataclasses import asdict, is_dataclass
+from pathlib import Path
+from typing import Any
+from uuid import uuid4
+
+from .errors import EvoTraceError
+from .store import Store
+from .util import read_json, write_json
+
+ROLES = ('episode_miner_agent', 'candidate_gate_agent', 'task_hardener_agent', 'verifier_critic_agent')
+
+
+def _text(value):
+    if isinstance(value, str):
+        return value
+    if isinstance(value, list):
+        return '\n'.join(filter(None, (_text(v) for v in value)))
+    if isinstance(value, dict):
+        return _text(value.get('text') or value.get('content') or '')
+    return ''
+
+
+def _tool_failed(value):
+    if isinstance(value, list):
+        return any(_tool_failed(row) for row in value)
+    if isinstance(value, dict):
+        return value.get('isError') is True or _tool_failed(value.get('content'))
+    return False
+
+
+def read_session(path):
+    path = Path(path)
+    if path.suffix == '.zstd':
+        import zstandard
+        with path.open('rb') as stream, zstandard.ZstdDecompressor().stream_reader(stream) as reader:
+            text = reader.read().decode('utf-8')
+    else:
+        text = path.read_text(encoding='utf-8')
+    return [json.loads(row) for row in text.splitlines() if row.strip()]
+
+
+def collect_review(store: Store, *, candidate: str, token: str, session_path: Path, destination: Path):
+    """Publish full returned role reports, recorded route and actual validation status."""
+    from .catalog import bundle_sha256, has_matching_passed_run
+    state = read_json(store.root / 'reviews' / token / 'state.json')
+    if state.get('candidate') != candidate or state.get('token') != token:
+        raise EvoTraceError('Review does not belong to this candidate')
+    events = read_session(session_path)
+    calls, completed = {}, []
+    for index, event in enumerate(events):
+        data = event.get('data') or {}
+        if event.get('type') == 'tool/call' and data.get('name') in ROLES:
+            calls[str(data.get('callId'))] = {'role': data['name'], 'arguments': data.get('arguments'), 'call_index': index}
+        elif event.get('type') == 'tool/result':
+            message = data.get('message') or {}
+            cid = str((message.get('source') or {}).get('callId'))
+            if cid in calls and not _tool_failed(message) and not data.get('isError'):
+                completed.append({**calls.pop(cid), 'result_index': index, 'report': _text(message.get('content')),
+                                  'raw_result': message})
+    chain, position = [], len(events)
+    for role in reversed(ROLES):
+        possible = [r for r in completed if r['role'] == role and r['result_index'] < position and r['report']]
+        if not possible:
+            break
+        selected = max(possible, key=lambda r: r['result_index'])
+        chain.append(selected)
+        position = selected['call_index']
+    chain.reverse()
+    complete = len(chain) == len(ROLES)
+    route = state.get('route')
+    asset_id = state.get('assetCandidate')
+    bundle = store.benchmarks / asset_id if asset_id else None
+    verified = bool(bundle and bundle.is_dir() and bundle_sha256(bundle) == state.get('assetDigest')
+                    and has_matching_passed_run(store, asset_id, bundle))
+    status = ('ready' if complete and verified else
+              route if complete and route in {'reject', 'preference_only'} else 'incomplete')
+    result = {'schema_version': '1', 'candidate': candidate, 'review_token': token, 'status': status,
+              'route': route, 'roles_completed': complete, 'asset_verified': verified,
+              'all_role_reports': completed,
+              'bundle': str(bundle) if bundle else None, 'role_reports': chain,
+              'source_session': str(Path(session_path).resolve()), 'review_state': state}
+    result['source_session_bytes'] = Path(session_path).stat().st_size
+    destination = Path(destination)
+    destination.mkdir(parents=True, exist_ok=True)
+    for output in {destination, store.root / 'reviews' / token / 'reports'}:
+        output.mkdir(parents=True, exist_ok=True)
+        write_json(output / 'review-result.json', result)
+        for index, row in enumerate(chain, 1):
+            (output / f'{index:02d}_{row["role"]}.md').write_text(row['report'], encoding='utf-8')
+    return result
+
+
+def _plain(value: Any):
+    if is_dataclass(value):
+        return _plain(asdict(value))
+    if isinstance(value, Path):
+        return str(value)
+    if isinstance(value, dict):
+        return {k: _plain(v) for k, v in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_plain(v) for v in value]
+    return value
+
+
+class AssetService:
+    """Single product boundary; calibration, hardening and experience stay in EvoTrace."""
+    def __init__(self, store: Store):
+        self.store = store
+
+    def prepare_seed(self, candidate, *, expected_source_revision, timeout=900):
+        """Materialize and verify a review-bound parent before derived hardening."""
+        from .builder import build_mined_candidates
+        from .catalog import has_matching_passed_run
+        from .provenance import require_current_bundle, source_revision
+        session, trajectory = self.store.load_session(candidate)
+        if source_revision(session, trajectory) != expected_source_revision:
+            raise EvoTraceError('STALE_SOURCE: hardening parent changed after review started')
+        bundle = self.store.benchmarks / trajectory['session_id']
+        if not bundle.exists():
+            outcomes = build_mined_candidates(self.store, session_id=trajectory['session_id'], limit=1,
+                                              expected_source_revision=expected_source_revision)
+            if not bundle.exists():
+                raise EvoTraceError('Hardening seed construction failed: ' + str(_plain(outcomes)))
+        require_current_bundle(self.store, bundle)
+        if not has_matching_passed_run(self.store, trajectory['session_id'], bundle):
+            validation = self.operate('validate', bundle, timeout=timeout)
+            if not validation['passed']:
+                raise EvoTraceError('Hardening seed failed base/reference validation')
+        if not has_matching_passed_run(self.store, trajectory['session_id'], bundle):
+            raise EvoTraceError('Hardening seed validation did not publish matching evidence')
+        return {'bundle': str(bundle), 'verified': True}
+
+    def recover_hardening(self, *, token, child, calibration_dir, trials=5, target_passes=2, timeout=600,
+                         replace_interrupted=False):
+        from .hardening import resume_hardening
+        from .provenance import source_revision
+        state_path = self.store.root / 'reviews' / token / 'state.json'
+        state = read_json(state_path)
+        if state.get('token') != token or state.get('route') != 'derived_seed':
+            raise EvoTraceError('Hardening recovery requires the original derived-seed review')
+        session, trajectory = self.store.load_session(state['candidate'])
+        if source_revision(session, trajectory) != state['sourceRevision']:
+            raise EvoTraceError('Recovery parent source changed')
+        result = resume_hardening(self.store.benchmarks / state['candidate'], Path(child),
+            calibration_dir=Path(calibration_dir), store=self.store, trials=trials, target_passes=target_passes,
+            timeout=timeout, replace_interrupted=replace_interrupted)
+        state.update(assetCandidate=result['child_id'], assetDigest=result['bundle_sha256'], hardeningResult=result)
+        write_json(state_path, state)
+        return result
+
+    def products(self, bundle):
+        """Describe bound product evidence; callers decide its authorized audience."""
+        from .catalog import bundle_sha256, related_runs
+        from .provenance import require_current_bundle
+        bundle = Path(bundle).resolve()
+        require_current_bundle(self.store, bundle)
+        manifest = read_json(bundle / 'task.json')
+        current = bundle_sha256(bundle)
+        assets = [{'kind': 'task_bundle', 'path': str(bundle), 'audience': 'operator_and_verifier'}]
+        source = self.store.sessions / manifest['id']
+        if source.is_dir():
+            assets.append({'kind': 'source_recording', 'path': str(source), 'audience': 'operator'})
+        for path, run in related_runs(self.store, manifest['id']):
+            if run.get('bundle_sha256') == current:
+                assets.append({'kind': run.get('kind', 'run'), 'path': str(path), 'audience': 'operator'})
+        calibration_root = self.store.calibrations / manifest['id']
+        for path in calibration_root.glob('*/calibration.json'):
+            if read_json(path).get('bundle_sha256') == current:
+                assets.append({'kind': 'calibration', 'path': str(path.parent), 'audience': 'operator'})
+        for path in self.store.evolutions.glob('*/*/evolution.json'):
+            report = read_json(path)
+            if report.get('source_bundle_sha256') == current:
+                assets.append({'kind': 'experience_and_comparison', 'path': str(path.parent), 'audience': 'operator'})
+                experience = path.parent / 'experience/experience.json'
+                if experience.is_file():
+                    assets.append({'kind': 'compressed_experience', 'path': str(experience), 'audience': 'seed_meta'})
+        for path in (self.store.root / 'reviews').glob('*/state.json'):
+            state = read_json(path)
+            if state.get('assetCandidate') == manifest['id'] and state.get('assetDigest') == current:
+                assets.append({'kind': 'review_state', 'path': str(path), 'audience': 'operator'})
+                if (path.parent / 'reports').is_dir():
+                    assets.append({'kind': 'review_reports', 'path': str(path.parent / 'reports'), 'audience': 'operator'})
+        from .recorded_experience import products as recorded_products
+        assets.extend(recorded_products(self.store, bundle))
+        return {'schema_version': '1', 'task_id': manifest['id'], 'bundle_sha256': current, 'products': assets}
+
+    def operate(self, operation, bundle, *, held_out=None, **options):
+        from .catalog import record_run
+        from .provenance import require_current_bundle
+        bundle = Path(bundle)
+        require_current_bundle(self.store, bundle)
+        if operation == 'validate':
+            from .validation import validate_bundle_in_docker
+            report = validate_bundle_in_docker(bundle, **options)
+            record_run(self.store, kind='docker-validation', session_id=read_json(bundle / 'task.json')['id'],
+                       result=report, passed=bool(report['passed']),
+                       score=float((report.get('reference') or {}).get('score') or 0), bundle=bundle)
+            return report
+        if operation == 'calibrate':
+            from .calibration import calibrate_bundle
+            return _plain(calibrate_bundle(bundle, store=self.store, **options))
+        if operation == 'harden':
+            from .hardening import harden_bundle
+            return _plain(harden_bundle(bundle, store=self.store, **options))
+        if operation == 'evolve_experience':
+            from .evolution import evolve_experience
+            if held_out is None:
+                raise EvoTraceError('Experience comparison requires an independent task')
+            return _plain(evolve_experience(bundle, Path(held_out), store=self.store, **options))
+        raise EvoTraceError('Unsupported asset operation: ' + str(operation))
+
+    def compress_recording(self, *, runner, solver_result, workspace, source, request_id=None, timeout=600):
+        from .recorded_experience import compress_recording
+        return compress_recording(self.store, runner=runner, solver_result=solver_result,
+                                  workspace=workspace, source=source, request_id=request_id, timeout=timeout)
diff --git a/src/evotrace/locks.py b/src/evotrace/locks.py
new file mode 100644
index 0000000..b401418
--- /dev/null
+++ b/src/evotrace/locks.py
@@ -0,0 +1,83 @@
+"""Non-blocking per-task process locks; lock ownership ends with the file handle."""
+from __future__ import annotations
+
+import hashlib
+import inspect
+import os
+import threading
+from contextlib import contextmanager
+from functools import wraps
+
+from .errors import EvoTraceError
+from .util import imported_session_id
+
+_local = threading.local()
+
+
+@contextmanager
+def session_lock(store, session_id):
+    directory = store.root / "locks"
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / (hashlib.sha256(str(session_id).encode("utf-8")).hexdigest() + ".lock")
+    key = str(path.resolve())
+    held = getattr(_local, "held", set())
+    if key in held:
+        yield
+        return
+    with path.open("a+b") as handle:
+        handle.seek(0, 2)
+        if handle.tell() == 0:
+            handle.write(b"\0")
+            handle.flush()
+        handle.seek(0)
+        try:
+            if os.name == "nt":
+                import msvcrt
+                msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as exc:
+            raise EvoTraceError(f"BUSY: task {session_id} is being updated by another process") from exc
+        _local.held = held | {key}
+        try:
+            yield
+        finally:
+            _local.held = held
+            handle.seek(0)
+            if os.name == "nt":
+                import msvcrt
+                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
+            else:
+                import fcntl
+                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
+
+
+def locked_session(function):
+    signature = inspect.signature(function)
+
+    @wraps(function)
+    def run(*args, **kwargs):
+        from .store import Store
+        bound = signature.bind(*args, **kwargs)
+        bound.apply_defaults()
+        store = bound.arguments.get("store") or Store()
+        selector = bound.arguments.get("session_id")
+        if selector is None:
+            return function(*args, **kwargs)
+        if selector == "latest":
+            selector = store.load_session(selector)[1]["session_id"]
+            bound.arguments["session_id"] = selector
+        bound.arguments["store"] = store
+        with session_lock(store, selector):
+            return function(*bound.args, **bound.kwargs)
+    return run
+
+
+def locked_import(function):
+    @wraps(function)
+    def run(**kwargs):
