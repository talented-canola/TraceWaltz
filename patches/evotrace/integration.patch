@@ -0,0 +1,63 @@
+"""Read-only, revision-bound event windows for trajectory reviewers."""
+from __future__ import annotations
+
+import json
+
+from .catalog import resolve_candidate
+from .errors import EvoTraceError
+from .locks import session_lock
+from .provenance import source_revision
+from .util import load_jsonl
+
+
+def event_window(store, selector, *, offset=0, limit=10, revision=None, max_bytes=16384):
+    if offset < 0 or not 1 <= limit <= 100 or not 1024 <= max_bytes <= 32768:
+        raise EvoTraceError("Event window requires offset>=0, limit 1-100 and max-bytes 1024-32768")
+    sid = resolve_candidate(store, selector)["session_id"]
+    with session_lock(store, sid):
+        session, trajectory = store.load_session(sid)
+        current = source_revision(session, trajectory)
+        if revision is not None and revision != current:
+            raise EvoTraceError("STALE_SOURCE: event evidence changed; restart the read with its current revision")
+        events = list(load_jsonl(session / "events.jsonl"))
+        if offset > len(events):
+            raise EvoTraceError("Event offset exceeds the available event count")
+        result = {"session_id": sid, "source_revision": current, "offset": offset, "total_events": len(events),
+                  "events": [], "next_offset": None, "truncated": False}
+        calls = {}
+        pairs = {}
+        for index, event in enumerate(events):
+            data = event.get("data") or {}
+            call_id = data.get("call_id") if isinstance(data, dict) else None
+            if call_id and event.get("kind") == "tool.call":
+                calls[call_id] = index
+            elif call_id and event.get("kind") == "tool.result" and call_id in calls:
+                pairs[index] = calls[call_id]
+
+        def encoded(value):
+            return json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
+
+        for index in range(offset, min(len(events), offset + limit)):
+            row = {"event_id": f"{current}:{index}", "index": index, **events[index]}
+            if index in pairs:
+                row["call_event_id"] = f"{current}:{pairs[index]}"
+            result["events"].append(row)
+            result["next_offset"] = index + 1 if index + 1 < len(events) else None
+            if len(encoded(result)) + 1 > max_bytes:
+                result["events"].pop()
+                if result["events"]:
+                    break
+                raw = encoded(events[index])
+                row = {"event_id": f"{current}:{index}", "index": index, "kind": events[index].get("kind"),
+                       "truncated": True, "original_bytes": len(raw),
+                       "data_excerpt": raw[:max(0, max_bytes - 700)].decode("utf-8", errors="ignore")}
+                result["events"].append(row)
+                while len(encoded(result)) + 1 > max_bytes and row["data_excerpt"]:
+                    row["data_excerpt"] = row["data_excerpt"][:len(row["data_excerpt"]) // 2]
+                break
+        next_offset = offset + len(result["events"])
+        result["next_offset"] = next_offset if next_offset < len(events) else None
+        result["truncated"] = any(row.get("truncated", False) for row in result["events"])
+        if len(encoded(result)) + 1 > max_bytes:
+            raise EvoTraceError("Event metadata exceeds the selected output budget")
+        return result
