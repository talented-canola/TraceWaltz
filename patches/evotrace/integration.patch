+"""Synthetic asset identity regressions. Model/Docker attestations are explicit fakes."""
+import json
+import os
+import sys
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from evotrace.builder import build_mined_candidates
+from evotrace.calibration import CalibrationOutcome
+from evotrace.compiler import compile_session
+from evotrace.errors import EvoTraceError
+from evotrace.catalog import bundle_sha256, has_matching_passed_run, record_run
+from evotrace.cli import _candidate_detail, _asset_rows
+from evotrace.quality import bundle_manifest_is_runnable
+from evotrace.hardening import harden_bundle
+from evotrace.importers.codex import import_codex
+from evotrace.miner import mine_store
+from evotrace.store import Store
+from evotrace.util import read_json, write_json, write_jsonl
+
+
+def validation_fixture():
+    return {"protocol": "docker-two-state-v0.1", "provider": "docker", "passed": True,
+            "image": {"reference_isolated": True},
+            "gates": {"base_behavioral_failure": True, "reference_passes": True},
+            "controls": {"network": "none", "host_mounts": [], "docker_socket": False,
+                         "privileged": False, "no_new_privileges": True}}
+
+
+class AssetVersionTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="evotrace-version-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.repo = self.root / "repo"
+        self.repo.mkdir()
+        for args in [("init", "-q"), ("config", "user.name", "Synthetic Test"),
+                     ("config", "user.email", "test@example.invalid"), ("config", "core.autocrlf", "false")]:
+            self.git(*args)
+        (self.repo / "calc.py").write_text("def add(a, b):\n    return a - b\n", encoding="utf-8")
+        (self.repo / "extra.py").write_text("def multiply(a, b):\n    return a + b\n", encoding="utf-8")
+        (self.repo / "tests").mkdir()
+        (self.repo / "tests" / "test_calc.py").write_text("import unittest\nfrom calc import add\nclass T(unittest.TestCase):\n    def test_add(self): self.assertEqual(add(2, 3), 5)\n", encoding="utf-8")
+        self.git("add", ".")
+        self.git("commit", "-qm", "base")
+        self.base = self.git("rev-parse", "HEAD")
+        self.store = Store(self.root / "store")
+        self.history = self.root / "history-session.jsonl"
+        self.import_task()
+
+    def git(self, *args):
+        return subprocess.check_output(["git", "-C", str(self.repo), *args], text=True, encoding="utf-8", stderr=subprocess.STDOUT).strip()
+
+    def import_task(self, task="Repair addition for positive, negative and zero inputs."):
+        # No timestamps: the importer generates observation times which must not change identity.
+        write_jsonl(self.history, [
+            {"type": "session_meta", "payload": {"id": "version-case", "cwd": str(self.repo), "git": {"commit_hash": self.base}}},
+            {"type": "event_msg", "payload": {"type": "user_message", "message": task}},
+            {"type": "event_msg", "payload": {"type": "patch_apply_end", "success": True, "changes": {"calc.py": {"type": "update", "unified_diff": "@@ -1,2 +1,2 @@\n def add(a, b):\n-    return a - b\n+    return a + b\n"}}}},
+            {"type": "response_item", "payload": {"type": "function_call", "name": "exec_command", "arguments": json.dumps({"cmd": "python -m unittest discover -s tests"})}},
+        ])
+        _, self.trajectory = import_codex(self.history, self.store)
+        self.sid = self.trajectory["session_id"]
+        mine_store(self.store)
+
+    def build(self):
+        result = build_mined_candidates(self.store, session_id=self.sid)[0]
+        self.assertIn(result.status, {"built", "already_built", "rebuilt"}, result.error)
+        return Path(result.bundle)
+
+    def attest(self, bundle):
+        # Synthetic success record tests state matching, not real container correctness.
+        return record_run(self.store, kind="docker-validation", session_id=self.sid,
+                          result=validation_fixture(), passed=True, bundle=bundle)
+
+    def test_same_source_without_timestamps_keeps_revision_and_reuses_bundle(self):
+        first = self.trajectory.get("source_revision")
+        self.assertIsInstance(first, str)
+        self.assertTrue(first)
+        bundle = self.build()
+        self.import_task()
+        self.assertEqual(first, self.trajectory.get("source_revision"))
+        self.assertEqual(build_mined_candidates(self.store, session_id=self.sid)[0].status, "already_built")
+        self.assertEqual(read_json(bundle / "task.json").get("source_revision"), first)
+
+    def test_refreshed_source_rejects_cached_bundle_and_old_attestation(self):
+        bundle = self.build()
+        self.attest(bundle)
+        self.assertTrue(has_matching_passed_run(self.store, self.sid, bundle))
+        self.import_task("Extend addition to handle a new distinct input contract.")
+        result = build_mined_candidates(self.store, session_id=self.sid)[0]
+        self.assertEqual(result.status, "skipped")
+        self.assertIn("STALE_SOURCE", result.error or "")
+        self.assertFalse(has_matching_passed_run(self.store, self.sid, bundle))
+        detail = _candidate_detail(self.store, self.store.list_candidates()[0])
+        self.assertEqual(detail["status"], "Stale")
+        self.assertEqual(_asset_rows(self.store)[0]["status"], "Stale")
+
+    def test_additional_verification_command_cannot_reuse_old_build(self):
+        self.build()
+        result = build_mined_candidates(self.store, session_id=self.sid, extra_commands=["python -m compileall -q ."])[0]
+        self.assertEqual(result.status, "skipped")
+        self.assertIn("STALE_BUILD_SPEC", result.error or "")
+
+    def test_reference_patch_tamper_invalidates_current_source(self):
+        bundle = self.build()
+        self.attest(bundle)
+        session, _ = self.store.load_session(self.sid)
+        with (session / "patches" / "final.patch").open("a", encoding="utf-8") as handle:
+            handle.write("\n# altered recovered source\n")
+        self.assertFalse(has_matching_passed_run(self.store, self.sid, bundle))
+
+    def test_rebuild_archives_old_bundle_then_matches_current_source(self):
+        bundle = self.build()
+        old_digest = bundle_sha256(bundle)
+        self.import_task("Support a revised addition contract while keeping numeric inputs.")
+        result = build_mined_candidates(self.store, session_id=self.sid, rebuild=True)[0]
+        self.assertEqual(result.status, "rebuilt", result.error)
+        self.assertNotEqual(old_digest, bundle_sha256(Path(result.bundle)))
+        self.assertEqual(read_json(bundle / "task.json")["task"], self.trajectory["task"]["text"])
+        self.assertEqual(len(list((self.store.root / "archives" / "benchmarks").iterdir())), 1)
+
+    def test_hardening_summary_does_not_mutate_validated_bundle(self):
+        parent = self.build()
+        self.attest(parent)
+        observed = {}
+
+        class FakeHardener:
+            def run_prompt(self, workspace, prompt, *, timeout):
+                (workspace / "calc.py").write_text("def add(a, b):\n    return b if a is None else a + b\n", encoding="utf-8")
+                (workspace / "extra.py").write_text("def multiply(a, b):\n    return a if b is None else a * b\n", encoding="utf-8")
+                hidden = workspace / "evotrace_hidden_tests"
+                hidden.mkdir()
+                (hidden / "test_edges.py").write_text("import unittest\nclass T(unittest.TestCase):\n    def test_control(self): self.assertTrue(True)\n", encoding="utf-8")
+                write_json(workspace / ".evotrace-hardening.json", {"task": "Implement coordinated arithmetic handling across both modules, preserve numeric compatibility, and define explicit handling for None values and unsupported inputs. This is a synthetic control-flow fixture only.", "verification_commands": ["python -m unittest discover -s evotrace_hidden_tests"]})
+                return {"stdout": "Synthetic hardener response"}
+
+        def validate(bundle, **kwargs):
+            observed["digest"] = bundle_sha256(bundle)
+            return validation_fixture()
+
+        calibration = CalibrationOutcome("synthetic", self.root / "cal", self.root / "cal-run", "calibrated", 2, 5, 2, 1, {})
+        with patch("evotrace.hardening.DeepSeekHarnessSolver", return_value=FakeHardener()), patch("evotrace.hardening.validate_bundle_in_docker", side_effect=validate), patch("evotrace.hardening.calibrate_bundle", return_value=calibration):
+            result = harden_bundle(parent, store=self.store)
+        self.assertEqual(observed["digest"], bundle_sha256(result.bundle))
+        self.assertTrue(has_matching_passed_run(self.store, result.child_id, result.bundle))
+        self.assertFalse((result.bundle / "hardening-result.json").exists())
+        self.assertTrue(any(run[1]["kind"] == "hardening-summary" for run in self.store.list_runs()))
+        self.assertTrue(bundle_manifest_is_runnable(read_json(result.bundle / "task.json")))
+        child = next(row for row in self.store.list_candidates() if row["session_id"] == result.child_id)
+        self.assertEqual(_candidate_detail(self.store, child)["status"], "Verified")
+        self.assertEqual(build_mined_candidates(self.store, session_id=result.child_id)[0].status, "already_built")
+
+    def test_legacy_bundle_cannot_inherit_a_successful_attestation(self):
+        bundle = self.build()
+        manifest = read_json(bundle / "task.json")
+        manifest.pop("source_revision")
+        write_json(bundle / "task.json", manifest)
+        self.attest(bundle)
+        self.assertFalse(has_matching_passed_run(self.store, self.sid, bundle))
+
+    def test_rebuild_failure_restores_the_previous_complete_bundle(self):
+        bundle = self.build()
+        old = bundle_sha256(bundle)
+        with patch("evotrace.compiler._dockerfile", side_effect=EvoTraceError("Injected late compilation failure")):
+            result = build_mined_candidates(self.store, session_id=self.sid, rebuild=True)[0]
+        self.assertEqual(result.status, "skipped")
+        self.assertEqual(bundle_sha256(bundle), old)
+        self.assertTrue((bundle / "Dockerfile").is_file())
+
+    def test_direct_compile_failure_never_publishes_a_partial_task(self):
+        with patch("evotrace.compiler._dockerfile", side_effect=EvoTraceError("Injected late compilation failure")):
+            with self.assertRaisesRegex(EvoTraceError, "Injected late"):
+                compile_session(self.sid, store=self.store)
+        self.assertFalse((self.store.benchmarks / self.sid).exists())
+
+    def test_expected_review_revision_is_checked_before_building(self):
+        expected = self.trajectory.get("source_revision")
+        self.import_task("A revised requirement arrives while the review is running.")
+        result = build_mined_candidates(self.store, session_id=self.sid, expected_source_revision=expected)[0]
+        self.assertEqual(result.status, "skipped")
+        self.assertIn("STALE_SOURCE", result.error or "")
+        self.assertFalse((self.store.benchmarks / self.sid).exists())
+
+    def test_other_process_cannot_import_while_task_is_locked(self):
+        from evotrace.locks import session_lock
+        code = "from pathlib import Path; from evotrace.importers.codex import import_codex; from evotrace.store import Store; import sys; import_codex(Path(sys.argv[1]), Store(Path(sys.argv[2])))"
+        command = [sys.executable, "-X", "utf8", "-c", code, str(self.history), str(self.store.root)]
+        with session_lock(self.store, self.sid):
+            blocked = subprocess.run(command, capture_output=True, text=True, encoding="utf-8", timeout=10)
+        self.assertNotEqual(blocked.returncode, 0)
+        self.assertIn("BUSY", blocked.stderr)
+        released = subprocess.run(command, capture_output=True, text=True, encoding="utf-8", timeout=10)
+        self.assertEqual(released.returncode, 0, released.stderr)
+
+    def test_io_failure_during_rebuild_preserves_previous_bundle(self):
+        bundle = self.build()
+        old = bundle_sha256(bundle)
+        with patch("evotrace.compiler._dockerfile", side_effect=OSError("Injected disk failure")):
+            result = build_mined_candidates(self.store, session_id=self.sid, rebuild=True)[0]
+        self.assertEqual(result.status, "skipped")
+        self.assertEqual(bundle_sha256(bundle), old)
+
+    def test_local_repository_identity_allows_distinct_tasks_without_origin(self):
+        from evotrace.evolution import _same_repository
+        first = read_json(self.build() / "task.json")
+        self.assertIsNone(first["repository"]["origin"])
+        self.assertTrue(first["repository"].get("local_id"))
+        second = dict(first, id="another-task")
+        self.assertTrue(_same_repository(first, second))
+        other = dict(first, repository={**first["repository"], "local_id": "different-checkout"})
+        self.assertFalse(_same_repository(first, other))
+
+    def test_late_result_cannot_certify_a_replaced_bundle(self):
+        bundle = self.build()
+        original = bundle_sha256(bundle)
+        (bundle / "task.md").write_text("A replacement arrived during validation.\n", encoding="utf-8")
+        with self.assertRaisesRegex(EvoTraceError, "STALE_BUNDLE"):
+            record_run(self.store, kind="docker-validation", session_id=self.sid,
+                       result={**validation_fixture(), "bundle_sha256": original}, passed=True, bundle=bundle)
+        self.assertFalse(has_matching_passed_run(self.store, self.sid, bundle))
+
+
+if __name__ == "__main__":
+    unittest.main()
