+++ b/tests/test_event_evidence.py
@@ -0,0 +1,62 @@
+import io
+import json
+import tempfile
+import unittest
+from contextlib import redirect_stdout, redirect_stderr
+from pathlib import Path
+
+from evotrace.cli import main
+from evotrace.store import Store
+from evotrace.util import write_json, write_jsonl
+
+
+class EventEvidenceTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory(prefix="evotrace-evidence-")
+        self.addCleanup(temporary.cleanup)
+        self.store = Store(Path(temporary.name) / "store")
+        self.store.initialize()
+        self.sid = "codex-evidence"
+        self.session = self.store.sessions / self.sid
+        self.session.mkdir()
+        write_json(self.session / "trajectory.json", {"session_id": self.sid, "source": {"kind": "history_import", "agent": "codex"}, "task": {"text": "Fix addition"}})
+        write_json(self.store.candidates / (self.sid + ".json"), {"session_id": self.sid, "score": 8, "labels": ["useful"]})
+        self.events = [{"kind": "message.user", "data": {"text": "Fix addition"}},
+                       {"kind": "tool.call", "data": {"name": "exec_command", "call_id": "check", "arguments": {"cmd": "python -m unittest"}}},
+                       {"kind": "tool.result", "data": {"call_id": "check", "output": "OK"}},
+                       {"kind": "message.user", "data": {"text": "FOLLOWUP_MULTIPLY: now fix multiplication"}}]
+        write_jsonl(self.session / "events.jsonl", self.events)
+
+    def invoke(self, *args):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            try:
+                code = main(["--home", str(self.store.root), "events", self.sid, *args])
+            except SystemExit as exc:
+                code = exc.code
+        return code, out.getvalue(), err.getvalue()
+
+    def test_second_request_and_call_pair_are_available_as_evidence(self):
+        code, text, err = self.invoke("--limit", "10")
+        self.assertEqual(code, 0, err)
+        result = json.loads(text)
+        self.assertIn("FOLLOWUP_MULTIPLY", text)
+        self.assertEqual(result["events"][2]["call_event_id"], result["events"][1]["event_id"])
+
+    def test_pagination_is_bound_to_the_source_revision(self):
+        code, text, err = self.invoke("--limit", "2")
+        self.assertEqual(code, 0, err)
+        page = json.loads(text)
+        self.assertEqual(page["next_offset"], 2)
+        self.events.append({"kind": "message.user", "data": {"text": "new request"}})
+        write_jsonl(self.session / "events.jsonl", self.events)
+        code, _, err = self.invoke("--offset", "2", "--revision", page["source_revision"])
+        self.assertEqual(code, 2)
+        self.assertIn("STALE_SOURCE", err)
+
+    def test_large_events_return_explicit_truncation_within_byte_budget(self):
+        write_jsonl(self.session / "events.jsonl", [{"kind": "message.user", "data": {"text": "合成内容" * 10000}}])
+        code, text, err = self.invoke("--max-bytes", "1024")
+        self.assertEqual(code, 0, err)
+        self.assertLessEqual(len(text.encode("utf-8")), 1024)
+        self.assertTrue(json.loads(text)["events"][0]["truncated"])
