@@ -0,0 +1,38 @@
+"""Verifier JSON is an execution contract, not a truthy model response."""
+import json
+import subprocess
+import unittest
+
+from evotrace.errors import EvoTraceError
+from evotrace.validation import _parse_report
+
+
+class VerifierReportTests(unittest.TestCase):
+    def parse(self, report, code=0):
+        return _parse_report(subprocess.CompletedProcess([], code, json.dumps(report), ""), "synthetic")
+
+    def test_malformed_reports_are_rejected_as_controlled_errors(self):
+        valid = {"passed": True, "score": 1.0, "checks": [{"name": "behavior", "passed": True}]}
+        cases = [
+            dict(valid, passed="false"),
+            dict(valid, checks=[]),
+            dict(valid, checks=[{"name": "behavior", "passed": "false"}]),
+            dict(valid, checks=[{"name": "behavior", "passed": False}]),
+            dict(valid, checks=[None]),
+            dict(valid, score=float("nan")),
+            dict(valid, score=2),
+            dict(valid, score="unknown"),
+        ]
+        for report in cases:
+            with self.subTest(report=report), self.assertRaises(EvoTraceError):
+                self.parse(report)
+
+    def test_success_report_cannot_disagree_with_process_exit(self):
+        with self.assertRaises(EvoTraceError):
+            self.parse({"passed": True, "score": 1.0, "checks": [{"name": "behavior", "passed": True}]}, 1)
+
+    def test_normal_success_and_failure_keep_typed_values(self):
+        for passed, score, code in [(True, 1.0, 0), (False, 0.0, 1)]:
+            result = self.parse({"passed": passed, "score": score, "checks": [{"name": "behavior", "passed": passed}]}, code)
+            self.assertIs(result["passed"], passed)
+            self.assertEqual(result["score"], score)
