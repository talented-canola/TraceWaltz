+++ b/tests/test_capsule_grounding.py
@@ -0,0 +1,34 @@
+import json
+import shutil
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from evotrace.evolution import _safe_capsule_text, trajectory_capsule
+
+
+class CapsuleGroundingTests(unittest.TestCase):
+    @unittest.skipUnless(shutil.which("zstd"), "Existing zstd executable required")
+    def test_real_zstd_pwsh_events_preserve_command_and_result(self):
+        with tempfile.TemporaryDirectory(prefix="evotrace-capsule-") as directory:
+            workspace = Path(directory)
+            events = [
+                {"seq": 10, "type": "tool/call", "data": {"callId": "call-probe", "name": "pwsh", "arguments": json.dumps({"command": "python -m unittest discover -s tests -v"})}},
+                {"seq": 11, "type": "tool/result", "data": {"message": {"source": {"callId": "call-probe"}, "content": [{"type": "text", "text": "Ran 3 tests: OK"}]}}},
+            ]
+            encoded = "\n".join(json.dumps(event) for event in events).encode()
+            path = workspace / "session.jsonl.zstd"
+            path.write_bytes(subprocess.run([shutil.which("zstd"), "-q", "-c"], input=encoded, capture_output=True, check=True).stdout)
+            capsule, stats = trajectory_capsule({"session_log_path": str(path)}, workspace=workspace)
+            self.assertEqual(stats["execution_commands"], ["python -m unittest discover -s tests -v"])
+            self.assertEqual(stats["tool_results"], 1)
+            self.assertIn("Ran 3 tests: OK", capsule)
+
+    def test_inline_literal_choices_survive_while_absolute_paths_are_redacted(self):
+        text = "Use `True`/`False`, `ms`/`s`, and `nan`/`inf`. Private paths: /home/private/project/code.py and C:\\Private\\secret.txt"
+        result = _safe_capsule_text(text, Path.cwd())
+        self.assertIn("`True`/`False`", result)
+        self.assertIn("`ms`/`s`", result)
+        self.assertNotIn("private/project", result)
+        self.assertNotIn("C:\\Private", result)
