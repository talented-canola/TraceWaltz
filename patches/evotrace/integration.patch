+"""Pure packet constraints; model response below is an explicit unit-test fixture."""
+import json
+import unittest
+
+from evotrace.evolution import compress_experience
+
+
+class PacketAgent:
+    def __init__(self, summary="Observed unittest execution."):
+        self.summary = summary
+
+    def run_prompt(self, workspace, prompt, *, timeout):
+        return {"stdout": json.dumps({"summary": self.summary, "runtime_facts": ["The observed command passed."],
+                "useful_commands": ["python -m unittest discover -s tests", "pytest --new-invented-option"],
+                "code_locations": [], "failure_modes": [], "do_not_assume": [], "confidence": "medium"})}
+
+
+class ExperiencePacketTests(unittest.TestCase):
+    def capsule(self):
+        return 'TOOL pwsh: {"command":"python -m unittest discover -s tests"}\n\nRESULT pwsh: Ran tests OK.\n' + "Observed output. " * 150
+
+    def test_useful_commands_are_limited_to_recorded_calls(self):
+        experience, provenance = compress_experience(PacketAgent(), capsule=self.capsule(), timeout=5)
+        self.assertEqual(experience["useful_commands"], ["python -m unittest discover -s tests"])
+        self.assertIn("pytest --new-invented-option", provenance["unmatched_commands"])
+
+    def test_oversized_output_is_not_accepted_as_compressed_experience(self):
+        _, provenance = compress_experience(PacketAgent("Very long summary. " * 180), capsule=self.capsule(), timeout=5)
+        self.assertFalse(provenance["structured_output"])
+        self.assertTrue(any("budget" in error for error in provenance["schema_errors"]))
+
+    def test_one_invalid_json_response_can_be_corrected_once(self):
+        class CorrectingAgent(PacketAgent):
+            calls = 0
+
+            def run_prompt(self, workspace, prompt, *, timeout):
+                self.calls += 1
+                return {"stdout": "{invalid-json"} if self.calls == 1 else super().run_prompt(workspace, prompt, timeout=timeout)
+
+        agent = CorrectingAgent()
+        _, provenance = compress_experience(agent, capsule=self.capsule(), timeout=5)
+        self.assertEqual(agent.calls, 2)
+        self.assertTrue(provenance["structured_output"])
