+"""Experience contracts and early rejection; no real model or container execution."""
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock, patch
+
+import test_evolution as fixtures
+from evotrace.calibration import _read_session_metadata
+from evotrace.errors import EvoTraceError
+from evotrace.evolution import compress_experience, evolve_experience
+from evotrace.importers.codex import import_codex
+from evotrace.store import Store
+from evotrace.util import write_jsonl
+
+
+class ExperienceBoundaryTests(unittest.TestCase):
+    def test_unrelated_or_wrongly_typed_json_is_not_structured_experience(self):
+        values = [{}, {"answer": 42}, {"summary": "Only a summary"},
+                  {"summary": "text", "runtime_facts": 12, "useful_commands": [], "code_locations": [], "failure_modes": [], "do_not_assume": [], "confidence": "high"}]
+        for value in values:
+            with self.subTest(value=value):
+                agent = Mock()
+                agent.run_prompt.return_value = {"stdout": json.dumps(value)}
+                _, metadata = compress_experience(agent, capsule="Synthetic tool result", timeout=1)
+                self.assertFalse(metadata["structured_output"])
+
+    def test_valid_experience_contract_is_accepted(self):
+        value = {"summary": "A synthetic runtime fact", "runtime_facts": ["The function returned -1"],
+                 "useful_commands": ["python -m unittest"], "code_locations": ["calc.py:add"],
+                 "failure_modes": [], "do_not_assume": [], "confidence": "medium"}
+        agent = Mock()
+        agent.run_prompt.return_value = {"stdout": json.dumps(value)}
+        experience, metadata = compress_experience(agent, capsule="Synthetic tool result", timeout=1)
+        self.assertTrue(metadata["structured_output"])
+        self.assertEqual(experience["runtime_facts"], value["runtime_facts"])
+
+    def test_comment_only_heldout_is_rejected_before_any_agent_call(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            store, source, heldout = fixtures.EvolutionTests().make_bundles(Path(temporary))
+            original = (source / "patches" / "reference.patch").read_text(encoding="utf-8")
+            (heldout / "patches" / "reference.patch").write_text(original.replace("return a + b", "return a + b  # relabeled answer"), encoding="utf-8")
+            agent = Mock(wraps=fixtures.FakeExperienceAgent())
+            with patch("evotrace.evolution._run_attempt", return_value={"passed": False, "solver": {"observed_external_file_access": False}}):
+                with self.assertRaisesRegex(EvoTraceError, "NONINDEPENDENT_HELD_OUT"):
+                    evolve_experience(source, heldout, store=store, agent=agent, trials=3)
+            agent.run_prompt.assert_not_called()
+
+    def test_windows_absolute_tool_path_is_flagged_outside_workspace(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            workspace = root / "workspace"
+            workspace.mkdir()
+            line = json.dumps({"type": "tool/call", "data": {"arguments": json.dumps({"path": str(root / "outside.py")})}})
+            with patch("evotrace.calibration.shutil.which", return_value="synthetic-zstd"), patch("evotrace.calibration.subprocess.run", return_value=SimpleNamespace(returncode=0, stdout=line)):
+                result = _read_session_metadata(root / "session.jsonl.zstd", workspace=workspace, forbidden_roots=[])
+            self.assertTrue(result["observed_external_file_access"])
+
+    def test_payload_array_has_a_controlled_import_error(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            source = root / "history.jsonl"
+            write_jsonl(source, [{"type": "session_meta", "payload": ["invalid"]}])
+            with self.assertRaisesRegex(EvoTraceError, "payload"):
+                import_codex(source, Store(root / "store"))
