+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+import zstandard
+from evotrace.calibration import _read_session_metadata
+from evotrace.evolution import trajectory_capsule
+
+
+class PythonTraceDecoder(unittest.TestCase):
+    def test_metadata_and_capsule_keep_real_tool_events_without_external_zstd(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            workspace = root / 'workspace'
+            workspace.mkdir()
+            session = root / 'session.jsonl.zstd'
+            rows = [
+                {'type': 'request/header', 'data': {'header': {'config': {'provider': 'deepseek-official', 'model': 'fixture'}}}},
+                {'type': 'tool/call', 'data': {'name': 'bash', 'callId': 'one', 'arguments': json.dumps({'command': 'python -m unittest -v'})}},
+                {'type': 'tool/result', 'data': {'message': {'source': {'callId': 'one'}, 'content': [{'type': 'text', 'text': 'Ran 2 tests; OK'}]}}},
+            ]
+            session.write_bytes(zstandard.ZstdCompressor().compress(('\n'.join(map(json.dumps, rows)) + '\n').encode()))
+            with patch('shutil.which', return_value=None):
+                metadata = _read_session_metadata(session, workspace=workspace, forbidden_roots=[])
+                capsule, stats = trajectory_capsule({'session_log_path': str(session)}, workspace=workspace)
+            self.assertEqual(metadata['tool_calls'], 1)
+            self.assertEqual(metadata['model'], 'fixture')
+            self.assertFalse(metadata['observed_external_file_access'])
+            self.assertIn('Ran 2 tests; OK', capsule)
+            self.assertIn('python -m unittest -v', capsule)
+
+
+if __name__ == '__main__':
+    unittest.main()
