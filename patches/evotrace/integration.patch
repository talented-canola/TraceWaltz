--- /dev/null
+++ b/src/evotrace/recorded_experience.py
@@ -0,0 +1,131 @@
+"""Turn an imported coding recording into source-bound, unvalidated experience."""
+from __future__ import annotations
+
+import re
+import shutil
+from pathlib import Path
+
+from .errors import EvoTraceError
+from .locks import session_lock
+from .provenance import digest_json, file_digest
+from .util import read_json, utc_now, write_json
+
+
+def compress_recording(store, *, runner, solver_result, workspace, source, request_id=None, timeout=600):
+    from .evolution import trajectory_capsule, compress_experience, _experience_markdown
+    from .integration import read_session
+
+    if not isinstance(source, dict) or not isinstance(source.get('session_id'), str):
+        raise EvoTraceError('Recorded experience requires an imported source session')
+    if not re.fullmatch(r'[A-Za-z0-9_-]{1,120}', source['session_id']):
+        raise EvoTraceError('Invalid imported source session identifier')
+    session_dir, trajectory = store.load_session(source['session_id'])
+    if not isinstance(trajectory.get('source_revision'), str) or not trajectory['source_revision']:
+        raise EvoTraceError('Recorded experience requires a versioned source recording')
+    trace = Path(solver_result.get('session_log_path') or '')
+    if not trace.is_file():
+        raise EvoTraceError('The original native recording is missing')
+    trace_hash = file_digest(trace)
+    events = read_session(trace)
+    headers = [row for row in events if row.get('type') == 'session']
+    native_session = (trajectory.get('source') or {}).get('source_session_id')
+    if len(headers) != 1 or headers[0].get('id') != native_session:
+        raise EvoTraceError('Native recording does not belong to the imported session')
+    bridge = session_dir / 'bridge.json'
+    if bridge.exists():
+        expected = (read_json(bridge).get('input') or {}).get('trace', '').removeprefix('sha256:')
+        if expected != trace_hash:
+            raise EvoTraceError('Native recording changed after import')
+    binding = {'source': source, 'source_revision': trajectory.get('source_revision'), 'trace_digest': trace_hash}
+    request_digest = digest_json(binding)
+    request_id = request_id or 'recorded-' + request_digest[:24]
+    if not isinstance(request_id, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,120}', request_id):
+        raise EvoTraceError('Invalid recorded experience request identifier')
+    destination = store.evolutions / 'recorded' / request_id
+    report_path = destination / 'recorded-experience.json'
+    with session_lock(store, 'recorded-experience-' + request_id):
+        if report_path.exists():
+            saved = read_json(report_path)
+            if saved.get('request_digest') != request_digest:
+                raise EvoTraceError('Recorded experience request belongs to different inputs')
+            if saved.get('status') != 'completed':
+                raise EvoTraceError('Recorded experience needs recovery; model execution is not resubmitted')
+            for name, expected in saved['files'].items():
+                if file_digest(destination / name) != expected:
+                    raise EvoTraceError('Recorded experience artifact changed: ' + name)
+            return saved
+        destination.mkdir(parents=True, exist_ok=False)
+        suffix = '.jsonl.zstd' if trace.suffix == '.zstd' else '.jsonl'
+        archived = destination / ('recording' + suffix)
+        shutil.copyfile(trace, archived)
+        if file_digest(archived) != trace_hash:
+            raise EvoTraceError('Native recording changed during capture')
+        # Keep the raw recording as well as the original compressor's bounded
+        # capsule. Its compression policy is not a full-feedback projection.
+        recorded = {**solver_result, 'session_log_path': str(archived)}
+        capsule, stats = trajectory_capsule(recorded, workspace=Path(workspace))
+        (destination / 'trajectory-capsule.txt').write_text(capsule, encoding='utf-8')
+        write_json(destination / 'source.json', {**binding, 'full_recording': recorded, 'capsule_stats': stats})
+        initial = {'schema_version': '1', 'kind': 'recorded_coding_experience', 'status': 'submitted',
+                   'request_digest': request_digest, 'source_session_id': source['session_id'],
+                   'source_revision': trajectory.get('source_revision'), 'directory': str(destination),
+                   'utility': 'not_evaluated', 'started_at': utc_now()}
+        write_json(report_path, initial)
+        experience, compression = compress_experience(runner, capsule=capsule, timeout=timeout)
+        write_json(destination / 'experience.json', experience)
+        write_json(destination / 'compression.json', compression)
+        (destination / 'experience.md').write_text(_experience_markdown(experience), encoding='utf-8')
+        accepted = bool(compression.get('structured_output')) and compression.get('agent_exit_code') in (None, 0)
+        assessment = {'schema_version': '1', 'origin': 'actual coding recording',
+                      'source_session_id': source['session_id'], 'source_revision': trajectory.get('source_revision'),
+                      'compression_accepted': accepted, 'utility': 'not_evaluated',
+                      'comparison_performed': False, 'capsule_stats': stats,
+                      'full_recording_retained': True}
+        write_json(destination / 'assessment.json', assessment)
+        names = [archived.name, 'trajectory-capsule.txt', 'source.json', 'experience.json',
+                 'compression.json', 'experience.md', 'assessment.json']
+        report = {**initial, 'status': 'completed', 'completed_at': utc_now(),
+                  'compression_accepted': accepted, 'full_recording_retained': True,
+                  'files': {name: file_digest(destination / name) for name in names}}
+        write_json(report_path, report)
+        return report
+
+
+def products(store, bundle):
+    """Attach recordings only to the exact source or a verified derived task."""
+    from .catalog import bundle_sha256
+    recordings = list((store.evolutions / 'recorded').glob('*/recorded-experience.json'))
+    if not recordings:
+        return []
+    manifest = read_json(Path(bundle) / 'task.json')
+    lineage = {manifest['id']: manifest.get('source_revision')}
+    seen = set(lineage)
+    current = manifest
+    while (current.get('source') or {}).get('parent_id'):
+        origin = current['source']
+        parent_id = origin['parent_id']
+        if not isinstance(parent_id, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,120}', parent_id):
+            raise EvoTraceError('Invalid task parent identifier')
+        if parent_id in seen:
+            raise EvoTraceError('Task lineage contains a cycle')
+        seen.add(parent_id)
+        parent = store.benchmarks / parent_id
+        expected = origin.get('parent_bundle_sha256')
+        if not expected or not (parent / 'task.json').is_file() or bundle_sha256(parent) != expected:
+            raise EvoTraceError('Recorded experience parent source is unavailable or changed')
+        current = read_json(parent / 'task.json')
+        lineage[current['id']] = current.get('source_revision')
+    assets = []
+    for path in recordings:
+        report = read_json(path)
+        source = report.get('source_session_id')
+        if source not in lineage or report.get('source_revision') != lineage[source] or report.get('status') != 'completed':
+            continue
+        for name, expected in report['files'].items():
+            if file_digest(path.parent / name) != expected:
+                raise EvoTraceError('Recorded experience artifact changed: ' + name)
+        assets.append({'kind': 'recorded_experience', 'path': str(path.parent), 'audience': 'operator'})
+        if report.get('compression_accepted'):
+            assets += [{'kind': 'compressed_experience', 'path': str(path.parent / 'experience.json'), 'audience': 'seed_meta'},
+                       {'kind': 'recorded_experience_assessment', 'path': str(path.parent / 'assessment.json'), 'audience': 'seed_meta'}]
+    return assets
