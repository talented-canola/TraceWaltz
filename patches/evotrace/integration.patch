@@ -0,0 +1,44 @@
+"""Reference patches must replay against the exact bytes in the exported base."""
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from evotrace.gitops import write_patch
+from evotrace.reconstruction import recover_reference_patch
+
+
+class PatchByteTests(unittest.TestCase):
+    def setUp(self):
+        self.folder = tempfile.TemporaryDirectory(prefix="evotrace-patch-bytes-")
+        self.addCleanup(self.folder.cleanup)
+        self.root = Path(self.folder.name)
+        self.repo = self.root / "repo"
+        self.repo.mkdir()
+        for args in [("init", "-q"), ("config", "core.autocrlf", "false"), ("config", "user.name", "Synthetic"), ("config", "user.email", "test@example.invalid")]:
+            self.git(*args)
+        self.before = b"def add(a, b):\r\n    return a - b\r\n"
+        (self.repo / "calc.py").write_bytes(self.before)
+        self.git("add", ".")
+        self.git("commit", "-qm", "CRLF base")
+
+    def git(self, *args):
+        return subprocess.run(["git", "-C", str(self.repo), *args], check=True, capture_output=True).stdout
+
+    def test_captured_patch_preserves_crlf_content_bytes(self):
+        after = self.before.replace(b"a - b", b"a + b")
+        (self.repo / "calc.py").write_bytes(after)
+        patch = self.root / "reference.patch"
+        write_patch(self.repo, patch)
+        self.git("reset", "--hard", "HEAD")
+        self.git("apply", "--whitespace=nowarn", str(patch))
+        self.assertEqual((self.repo / "calc.py").read_bytes(), after)
+
+    def test_reconstructed_patch_matches_archived_crlf_base(self):
+        session = self.root / "session"
+        repository = {"root": str(self.repo), "base_commit": self.git("rev-parse", "HEAD").decode().strip()}
+        events = [{"kind": "tool.call", "data": {"name": "apply_patch", "arguments": {"changes": {"calc.py": {"type": "update", "unified_diff": "@@ -1,2 +1,2 @@\n def add(a, b):\n-    return a - b\n+    return a + b\n"}}}}}]
+        report = recover_reference_patch(session, repository, events)
+        self.assertEqual(report["status"], "recovered", report)
+        self.git("apply", "--whitespace=nowarn", str(session / "patches" / "final.patch"))
+        self.assertEqual((self.repo / "calc.py").read_bytes(), self.before.replace(b"a - b", b"a + b"))
