diff --git a/harness/tests/review-identity.test.mjs b/harness/tests/review-identity.test.mjs
new file mode 100644
index 0000000..d81d31e
--- /dev/null
+++ b/harness/tests/review-identity.test.mjs
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {mkdtempSync} from 'node:fs'
+import {join} from 'node:path'
+import {tmpdir} from 'node:os'
+import {apply,createReviewCommand} from '../plugins/orchestrator.mjs'
+
+function tools(){const rows=[];apply({tools:{register:t=>rows.push(t)},commands:{register:()=>()=>{}},effect:f=>f()});return rows}
+
+test('numeric review input is resolved once to a stable id for the model and route', async()=>{
+  const rows=tools();const messages=[]
+  const command=createReviewCommand({preflightCandidate:async()=>JSON.stringify({session_id:'codex-original',source_revision:'revision-original'})})
+  const response=await command.handler({rawInput:'1',agent:{steer:m=>messages.push(m)}})
+  assert.equal(response.kind,'success')
+  const text=messages[0].content.map(c=>c.text??'').join(' ')
+  assert.match(text,/candidate codex-original/)
+  const token=text.match(/Review token: ([0-9a-f-]+)/)[1]
+  const route=rows.find(t=>t.name==='review_route')
+  await route.execute({reviewToken:token,candidate:'codex-original',route:'direct',rationale:'Synthetic review identity check.'},{signal:new AbortController().signal})
+  await assert.rejects(()=>route.execute({reviewToken:token,candidate:'1',route:'direct',rationale:'Numeric selectors must not be reinterpreted.'},{signal:new AbortController().signal}),/lineage violation/)
+})
+
+test('unparseable preflight cannot start an unbound review',async()=>{
+  const messages=[]
+  const command=createReviewCommand({preflightCandidate:async()=> 'not candidate JSON'})
+  const response=await command.handler({rawInput:'1',agent:{steer:m=>messages.push(m)}})
+  assert.equal(response.kind,'error')
+  assert.equal(messages.length,0)
+})
+
+test('a reloaded plugin recovers the recorded route for the same review token',async()=>{
+  const previous=process.env.EVOTRACE_STORE_HOME
+  process.env.EVOTRACE_STORE_HOME=mkdtempSync(join(tmpdir(),'evotrace-review-state-'))
+  try{
+    const rows=tools();const messages=[]
+    const command=createReviewCommand({preflightCandidate:async()=>JSON.stringify({session_id:'codex-persisted',source_revision:'synthetic-revision'})})
+    await command.handler({rawInput:'1',agent:{steer:m=>messages.push(m)}})
+    const token=messages[0].content[0].text.match(/Review token: ([0-9a-f-]+)/)[1]
+    const args={reviewToken:token,candidate:'codex-persisted',route:'direct',rationale:'Persistent route fixture'}
+    await rows.find(t=>t.name==='review_route').execute(args,{signal:new AbortController().signal})
+    const reloaded=await import('../plugins/orchestrator.mjs?state_reload='+Date.now())
+    const recovered=[];reloaded.apply({tools:{register:t=>recovered.push(t)},commands:{register:()=>()=>{}},effect:f=>f()})
+    await assert.rejects(()=>recovered.find(t=>t.name==='review_route').execute(args,{signal:new AbortController().signal}),/route is immutable/)
+  }finally{
+    if(previous===undefined)delete process.env.EVOTRACE_STORE_HOME
+    else process.env.EVOTRACE_STORE_HOME=previous
+  }
+})
