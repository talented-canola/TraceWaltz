@@ -0,0 +1,75 @@
+"""Actual headless DSH transport with a local response server: zero paid API calls."""
+import json
+import os
+import shutil
+import tempfile
+import threading
+import unittest
+from contextlib import contextmanager
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from unittest.mock import patch
+
+from evotrace.calibration import DeepSeekHarnessSolver, _session_files
+from evotrace.store import Store
+
+
+@contextmanager
+def local_temporary(prefix):
+    root = Path(tempfile.mkdtemp(prefix=prefix)).resolve()
+    try:
+        yield str(root)
+    finally:
+        if root.parent != Path(tempfile.gettempdir()).resolve() or not root.name.startswith(prefix):
+            raise AssertionError("Unexpected test cleanup target")
+        target = "\\\\?\\" + str(root) if os.name == "nt" else str(root)
+        shutil.rmtree(target)
+
+
+class NativeSolverTests(unittest.TestCase):
+    @unittest.skipUnless(os.name == "nt", "Windows command-wrapper regression")
+    def test_multiline_task_and_experience_reach_actual_headless_request(self):
+        requests = []
+
+        class ResponseServer(BaseHTTPRequestHandler):
+            def log_message(self, *args):
+                pass
+
+            def do_POST(self):
+                requests.append(json.loads(self.rfile.read(int(self.headers["Content-Length"]))))
+                self.send_response(200)
+                self.send_header("Content-Type", "text/event-stream")
+                self.end_headers()
+                payload = {"id": "local-contract", "choices": [{"index": 0, "delta": {"role": "assistant", "content": "Observed."}, "finish_reason": "stop"}], "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}
+                self.wfile.write(("data: " + json.dumps(payload) + "\n\ndata: [DONE]\n\n").encode())
+
+        server = ThreadingHTTPServer(("127.0.0.1", 0), ResponseServer)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        try:
+            with local_temporary(prefix="evotrace-native-") as directory:
+                root = Path(directory)
+                home = root / "home"
+                home.mkdir()
+                (home / ".credentials.yaml").write_text("{}\n", encoding="utf-8")
+                workspace = root / "workspace"
+                workspace.mkdir()
+                environment = {"DSH_HOME": str(home), "DEEPSEEK_API_KEY": "local-contract-placeholder", "DEEPSEEK_BASE_URL": f"http://127.0.0.1:{server.server_port}", "DSH_TELEMETRY_DISABLED": "1", "PYTHONUTF8": "1"}
+                with patch.dict(os.environ, environment):
+                    result = DeepSeekHarnessSolver(Store(root / "store")).run_prompt(
+                        workspace, "Return Observed without using tools.\n\nTask: MULTILINE_TASK_SENTINEL.\n\nExperience: EXPERIENCE_SENTINEL.", timeout=40)
+                self.assertEqual(result["exit_code"], 0, result)
+                users = [str(message.get("content")) for request in requests for message in request["messages"] if message["role"] == "user"]
+                self.assertTrue(any("MULTILINE_TASK_SENTINEL" in text and "EXPERIENCE_SENTINEL" in text for text in users), users)
+        finally:
+            server.shutdown()
+            server.server_close()
+
+    @unittest.skipUnless(os.name == "nt", "Windows long-path regression")
+    def test_session_discovery_reads_long_paths(self):
+        with local_temporary(prefix="evotrace-long-session-") as directory:
+            home = Path(directory)
+            file = home / "sessions" / ("w" * 100) / ("s" * 100) / "session.jsonl.zstd"
+            extended = Path("\\\\?\\" + str(file.resolve()))
+            extended.parent.mkdir(parents=True)
+            extended.write_bytes(b"synthetic-file-discovery-only")
+            self.assertEqual(len(_session_files(home)), 1)
